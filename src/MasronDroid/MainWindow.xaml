<Window xmlns:local="clr-namespace:MasronDroid" x:Class="MasronDroid.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MasronDroid" Width="1060" Height="750" MinWidth="790" MinHeight="560" WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" Background="#F5F8FA" UseLayoutRounding="True" WindowStyle="None" BorderThickness="0">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Shell">
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Rail}" Padding="16,26,16,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
            <Image Width="43" Height="43" Source="Assets/masrondroid.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="MasronDroid" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="6,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{DynamicResource Workspace}" Margin="12,0,0,8" Foreground="#ADC5D1" FontSize="12"/>
          <StackPanel x:Name="Navigation">
            <RadioButton x:Name="NavDevice" Tag="Device" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" AutomationProperties.Name="{DynamicResource Device}">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" Text="&#xE8EA;"/><TextBlock Text="{DynamicResource Device}"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavInstall" Tag="Install" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" AutomationProperties.Name="{DynamicResource Install}">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" Text="&#xE896;"/><TextBlock Text="{DynamicResource Install}"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavDebloat" Tag="Debloat" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" AutomationProperties.Name="{DynamicResource Debloat}">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" Text="&#xE81E;"/><TextBlock Text="{DynamicResource Debloat}"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavFastboot" Tag="Fastboot" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" AutomationProperties.Name="{DynamicResource Fastboot}">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" Text="&#xE945;"/><TextBlock Text="{DynamicResource Fastboot}"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavRecovery" Tag="Recovery" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" AutomationProperties.Name="{DynamicResource Recovery}">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" Text="&#xE777;"/><TextBlock Text="{DynamicResource Recovery}"/></StackPanel>
            </RadioButton>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="6,0">
          <Border Height="1" Background="#365160" Margin="0,0,0,14"/>
          <TextBlock x:Name="AppVersion" Foreground="#ADC5D1" Margin="0,0,0,8" FontSize="12"/>
          <TextBlock Text="{DynamicResource Language}" FontSize="12" Foreground="#BCD0DA" Margin="0,0,0,6"/>
          <ComboBox x:Name="Languages" AutomationProperties.Name="{DynamicResource Language}" SelectionChanged="LanguageChanged">
            <ComboBoxItem Tag="id">Bahasa Indonesia</ComboBoxItem><ComboBoxItem Tag="en">English</ComboBoxItem>
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="250"/><RowDefinition Height="9"/><RowDefinition Height="128" MinHeight="58"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="True">
      <Grid DockPanel.Dock="Top" Margin="28,0,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,21,5,0">
          <TextBlock x:Name="PageTitle" FontSize="32" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageDescription" Style="{StaticResource Body}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,5,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="MinimizeClick" ToolTip="{DynamicResource Minimize}" AutomationProperties.Name="{DynamicResource Minimize}"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="MaximizeClick" ToolTip="{DynamicResource Maximize}" AutomationProperties.Name="{DynamicResource Maximize}"/>
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseClick" ToolTip="{DynamicResource Close}" AutomationProperties.Name="{DynamicResource Close}"/>
        </StackPanel>
      </Grid>
      <Border DockPanel.Dock="Top" Padding="28,17,28,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource Target}" FontWeight="SemiBold" Margin="0,0,12,0"/>
          <Grid Grid.Column="1">
            <ComboBox x:Name="Targets" AutomationProperties.Name="{DynamicResource Target}" SelectionChanged="TargetChanged"/>
            <TextBlock x:Name="TargetHint" IsHitTestVisible="False" Style="{StaticResource Body}" Margin="11,0,24,0"/>
          </Grid>
          <Button x:Name="ScanButton" Grid.Column="2" Content="{DynamicResource Scan}" Margin="12,0,0,0" Click="ScanClick"/>
        </Grid>
      </Border>
      <Grid x:Name="WorkspaceBody" SizeChanged="WorkspaceResized">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="MirrorColumn" Width="0"/></Grid.ColumnDefinitions>
        <Border Grid.Column="1" x:Name="MirrorPane" Visibility="Collapsed" Margin="0,0,14,10" Background="#12232F" CornerRadius="10" Padding="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="MirrorTitle" Margin="6,4,6,7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" Foreground="White"/>
            <ToggleButton x:Name="StayAwake" DockPanel.Dock="Top" Click="StayAwakeClick" Margin="3,0,3,5" ToolTip="{DynamicResource StayAwakeHint}" AutomationProperties.Name="{DynamicResource StayAwake}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="SwitchBody" Padding="6,4" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" Background="#203A49">
                    <DockPanel>
                      <Border x:Name="Track" DockPanel.Dock="Right" Width="29" Height="16" CornerRadius="8" Background="#617684" VerticalAlignment="Center">
                        <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="2" Fill="White" HorizontalAlignment="Left"/>
                      </Border>
                      <TextBlock Text="{DynamicResource StayAwake}" Margin="0,0,4,0" Foreground="White" FontSize="12"/>
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#12847C"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchBody" Property="BorderBrush" Value="White"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <UniformGrid DockPanel.Dock="Bottom" Rows="1" Columns="3" Margin="2,3,2,0">
              <Button x:Name="AndroidBack" Tag="Back" Style="{StaticResource MirrorNav}" Click="AndroidNavClick" ToolTip="{DynamicResource AndroidBack}" AutomationProperties.Name="{DynamicResource AndroidBack}"><Path Data="M 16,2 L 4,9 16,16 Z" Stroke="#DCE8EF" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
              <Button x:Name="AndroidHome" Tag="Home" Style="{StaticResource MirrorNav}" Click="AndroidNavClick" ToolTip="{DynamicResource AndroidHome}" AutomationProperties.Name="{DynamicResource AndroidHome}"><Path Data="M 10,2 A 7,7 0 1 1 9.99,2 Z" Stroke="#DCE8EF" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
              <Button x:Name="AndroidRecent" Tag="Recent" Style="{StaticResource MirrorNav}" Click="AndroidNavClick" ToolTip="{DynamicResource AndroidRecent}" AutomationProperties.Name="{DynamicResource AndroidRecent}"><Path Data="M 3,3 H 17 V 16 H 3 Z" Stroke="#DCE8EF" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
            </UniformGrid>
            <local:MirrorHost x:Name="VideoSurface" Focusable="True"/>
          </DockPanel>
        </Border>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,0,28,20">
          <StackPanel x:Name="DevicePage">
            <Border CornerRadius="12" Background="#E1F1F2" BorderBrush="#BDDADC" BorderThickness="1" Padding="22,17" MinHeight="139">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Usb}" Foreground="#326779" FontWeight="Bold" FontSize="11"/>
                  <TextBlock x:Name="DeviceHeadline" FontSize="24" FontWeight="SemiBold" Margin="0,6"/>
                  <TextBlock x:Name="DeviceHint" Style="{StaticResource Body}" Margin="0,0,12,0"/>
                  <Button x:Name="ViewScreen" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="MirrorClick" Content="{DynamicResource Mirror}"/>
                </StackPanel>
                <Viewbox x:Name="PhoneOutline" Grid.Column="1" Width="95" Height="105" IsHitTestVisible="False">
                  <Canvas Width="98" Height="114">
                    <Path Data="M 24,56 H 4 M 85,56 H 96 M 54,5 V 0" Stroke="#89BBC2" StrokeThickness="1.5" StrokeDashArray="2,2"/>
                    <Rectangle Canvas.Left="29" Canvas.Top="4" Width="50" Height="84" RadiusX="8" RadiusY="8" Stroke="#35697B" Fill="#F4FBFB" StrokeThickness="2.6"/>
                    <Path Data="M 46,11 H 61 M 48,81 H 59 M 53,87 V 95 M 48,94 H 59 V 100 H 48 Z M 53,100 V 105 Q 53,110 59,110 H 73" Stroke="#35697B" StrokeThickness="2.2"/>
                    <Path Data="M 53,59 V 34 M 49,39 L 53,34 57,39 M 53,51 L 45,46 V 42 M 53,54 L 61,49 V 43" Stroke="#258193" StrokeThickness="2.4"/>
                    <Ellipse Canvas.Left="50" Canvas.Top="57" Width="6" Height="6" Fill="#258193"/>
                  </Canvas>
                </Viewbox>
                <Image x:Name="PhonePicture" Grid.Column="1" Width="95" Height="105" Stretch="Uniform" Visibility="Collapsed"/>
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel x:Name="InstallPage" Visibility="Collapsed">
            <Border Style="{StaticResource Panel}"><StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource InstallTitle}"/>
              <TextBlock Style="{StaticResource Body}" Text="{DynamicResource InstallHint}" Margin="0,6,0,14"/>
              <Button HorizontalAlignment="Left" Click="PickFile" Tag="apk" Content="{DynamicResource PickApk}"/>
              <TextBlock x:Name="ApkName" Margin="0,8,0,16" FontFamily="Consolas"/>
              <Button x:Name="InstallApk" HorizontalAlignment="Left" Style="{StaticResource Primary}" Tag="Install" Click="ActionClick" Content="{DynamicResource Install}"/>
              <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Text="{DynamicResource NeedAdb}"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="DebloatPage" Visibility="Collapsed">
            <Border Style="{StaticResource Panel}"><StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource Packages}"/>
              <TextBlock Style="{StaticResource Body}" Text="{DynamicResource NeedAdb}" Margin="0,4,0,12"/>
              <WrapPanel>
                <ComboBox x:Name="PackageMode" SelectedIndex="0" MinWidth="120" Margin="0,0,8,4" SelectionChanged="PackageModeChanged" AutomationProperties.Name="{DynamicResource Packages}">
                  <ComboBoxItem Content="{DynamicResource Enabled}"/><ComboBoxItem Content="{DynamicResource Disabled}"/>
                </ComboBox>
                <Button x:Name="LoadPackages" Click="LoadClick" Content="{DynamicResource Load}" Margin="0,0,0,4"/>
              </WrapPanel>
              <TextBlock Text="{DynamicResource Filter}" FontSize="12" Margin="0,9,0,4"/>
              <TextBox x:Name="Filter" AutomationProperties.Name="{DynamicResource Filter}" Padding="8,5" TextChanged="FilterChanged"/>
              <ListBox x:Name="PackageList" AutomationProperties.Name="{DynamicResource Packages}" Height="114" Margin="0,6,0,0" FontFamily="Consolas" SelectionChanged="PackageSelected"/>
              <TextBlock x:Name="PackageCount" Style="{StaticResource Body}" FontSize="12" Margin="0,4,0,9"/>
              <Button x:Name="ChangePackage" HorizontalAlignment="Left" Click="PackageClick"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="FastbootPage" Visibility="Collapsed">
            <Border Style="{StaticResource Panel}"><StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource BootTitle}"/>
              <TextBlock Style="{StaticResource Body}" Text="{DynamicResource BootHint}" Margin="0,6,0,16"/>
              <WrapPanel><Button x:Name="EnterBoot" Tag="Bootloader" Click="ActionClick" Content="{DynamicResource ToBoot}" Margin="0,0,8,6"/><Button x:Name="ReadProduct" Tag="Product" Click="ActionClick" Content="{DynamicResource Product}" Margin="0,0,8,6"/><Button x:Name="LeaveBoot" Tag="System" Click="ActionClick" Content="{DynamicResource ToSystem}" Margin="0,0,8,6"/></WrapPanel>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="RecoveryPage" Visibility="Collapsed">
            <Border Style="{StaticResource Panel}"><StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource RecoveryTitle}"/>
              <TextBlock Style="{StaticResource Body}" Text="{DynamicResource RecoveryHint}" Margin="0,6,0,14"/>
              <WrapPanel><Button x:Name="EnterRecovery" Tag="Recovery" Click="ActionClick" Content="{DynamicResource ToRecovery}" Margin="0,0,8,4"/><Button x:Name="LeaveRecovery" Tag="System" Click="ActionClick" Content="{DynamicResource ToSystem}" Margin="0,0,0,4"/></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel>
              <TextBlock Style="{StaticResource Section}" Text="{DynamicResource UpdateTitle}"/>
              <TextBlock Style="{StaticResource Body}" Text="{DynamicResource UpdateHint}" Margin="0,6,0,14"/>
              <WrapPanel><Button Click="PickFile" Tag="zip" Content="{DynamicResource PickZip}" Margin="0,0,8,4"/><Button x:Name="SendZip" Style="{StaticResource Primary}" Tag="Sideload" Click="ActionClick" Content="{DynamicResource Sideload}" Margin="0,0,0,4"/></WrapPanel>
              <TextBlock x:Name="ZipName" FontFamily="Consolas" Margin="0,6,0,0"/>
            </StackPanel></Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </DockPanel>
      <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Background="#D6E3E9" KeyboardIncrement="16" Focusable="True" AutomationProperties.Name="{DynamicResource ResizeLog}">
        <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="{TemplateBinding Background}"><Border Width="38" Height="3" CornerRadius="2" Background="#68838E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></GridSplitter.Template>
      </GridSplitter>
      <DockPanel Grid.Row="2" Background="#142733" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Margin="16,7,16,3" Foreground="#A0DBD9" FontWeight="SemiBold" Text="{DynamicResource Session}"/>
        <TextBox x:Name="Result" Margin="16,0,8,6" FontFamily="Consolas" FontSize="12" Background="Transparent" Foreground="#DCE9EE" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Session}"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
