                        <Button Tag="RecoveryFiles" Style="{StaticResource CompactAction}" Click="ActionClick" Margin="0,0,6,4" AutomationProperties.Name="{DynamicResource RecoveryFiles}" Background="#E5F3F3" Foreground="#176B70" BorderBrush="#BDDCDD"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource RecoveryFiles}" VerticalAlignment="Center"/></StackPanel></Button>
                      </WrapPanel>
                      <TextBox Name="RecoveryResult" Visibility="Collapsed" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#142733" CornerRadius="9" Padding="12" Margin="0,6,0,0">
                    <DockPanel>
                      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ConsoleButton}" Click="ClearConsole" AutomationProperties.Name="{DynamicResource ClearLog}" Background="#EAF0F4" Foreground="#334E60" BorderBrush="#CAD8E0"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE75C;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource ClearLog}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button IsEnabled="{Binding IsEnabled, ElementName=StopCommand}" DockPanel.Dock="Right" Style="{StaticResource ConsoleButton}" Margin="0,0,5,0" Click="StopConsole" AutomationProperties.Name="{DynamicResource Cancel}" Background="#FBECEF" Foreground="#9B3545" BorderBrush="#EAC8CE"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Cancel}" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="{DynamicResource RecoveryConsole}" VerticalAlignment="Center" Foreground="#AAC6CF" FontWeight="SemiBold"/>
                      </DockPanel>
                      <Border DockPanel.Dock="Bottom" Background="#0F202B" CornerRadius="5" Padding="8,4" Margin="0,6,0,0">
                        <DockPanel>
                          <TextBlock Text="adb ›" Foreground="#82DBC5" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,8,0"/>
                          <TextBox Name="RecoveryInput" KeyDown="ConsoleKey" AutomationProperties.Name="adb" FontFamily="Consolas" Style="{StaticResource FlatTextBox}" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                      </Border>
                      <TextBox Name="RecoveryOutput" LayoutUpdated="FitModeConsole" Text="{Binding Text, ElementName=ConsoleOutput, Mode=OneWay}" Height="145" TextChanged="ScrollConsole" IsVisibleChanged="ShowConsoleTail" Style="{StaticResource ConsoleOutputStyle}"/>
                    </DockPanel>
                  </Border>
                </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Grid>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,5,0" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource WindowButton}" Content="" ToolTip="{DynamicResource Minimize}" AutomationProperties.Name="{DynamicResource Minimize}" Click="MinimizeClick" />
        <Button Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="" ToolTip="{DynamicResource Maximize}" AutomationProperties.Name="{DynamicResource Maximize}" Click="MaximizeClick" />
        <Button Style="{StaticResource CloseButton}" Content="" ToolTip="{DynamicResource Close}" AutomationProperties.Name="{DynamicResource Close}" Click="CloseClick" />
      </StackPanel>
    </Grid>
    <Grid Name="OperationOverlay" Grid.ColumnSpan="2" Panel.ZIndex="700" Background="#80152E3E" Visibility="Collapsed" Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="460" Margin="28" Padding="24" CornerRadius="14" Background="White" BorderBrush="#D0DFE7" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Background="#E5F3F3" CornerRadius="11" Width="42" Height="42" Margin="0,0,12,0">
              <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#126782" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource FeedbackWorking}" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Name="OperationLabel" Foreground="#526577" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
          <ProgressBar Height="5" IsIndeterminate="True" Foreground="#126782" Background="#DFEBEF" BorderThickness="0" Margin="0,20,0,0"/>
          <StackPanel Margin="0,14,0,0">
            <StackPanel.Style><Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=BatchProgressCard}" Value="Visible"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></StackPanel.Style>
            <TextBlock Text="{Binding Text, ElementName=BatchStage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Text, ElementName=BatchCurrentApp}" Foreground="#526577" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <ProgressBar Height="6" Maximum="{Binding Maximum, ElementName=BatchProgress}" Value="{Binding Value, ElementName=BatchProgress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, ElementName=BatchProgress}" Foreground="#126782" Background="#DFEBEF" BorderThickness="0"/>
            <TextBlock Text="{Binding Text, ElementName=BatchProgressCount}" FontSize="12" Foreground="#526577" HorizontalAlignment="Right" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Border Name="ModalShade" Grid.ColumnSpan="2" Panel.ZIndex="800" Background="#80152E3E" Visibility="Collapsed"/>
    <ProgressBar Name="ActivityBar" Grid.ColumnSpan="2" Panel.ZIndex="900" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="Collapsed" Foreground="#34B4A8" Background="Transparent" BorderThickness="0" IsHitTestVisible="False"/>
  </Grid>
</Window>
